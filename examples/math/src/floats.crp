-- math floats module — f64 arithmetic (spec §3)

pub add(a: float, b: float) = a + b

pub mul(a: float, b: float) = a * b

pub div(a: float, b: float) = a / b

pub square(x: float) = x ** 2.0

pub avg2(a: float, b: float) = {
    s := a + b
    s / 2.0
}

test "float add" = {
    assert_eq(add(1.5, 2.5), 4.0)
}

test "float mul" = {
    assert_eq(mul(2.0, 3.5), 7.0)
}

test "float square" = {
    assert_eq(square(3.0), 9.0)
}

test_compile_fail "float int mix" = {
    add(1.0, 1)
}
