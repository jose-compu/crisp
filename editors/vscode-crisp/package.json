{
  "name": "crisp-lang",
  "displayName": "Crisp",
  "description": "Crisp language support — highlighting + optional crisp-lsp",
  "version": "0.1.0",
  "publisher": "jose-compu",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Programming Languages"
  ],
  "keywords": [
    "crisp",
    "crp",
    "crpc",
    "lsp"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/jose-compu/crisp"
  },
  "license": "MIT OR Apache-2.0",
  "activationEvents": [
    "onLanguage:crisp"
  ],
  "main": "./extension.js",
  "contributes": {
    "languages": [
      {
        "id": "crisp",
        "aliases": [
          "Crisp",
          "crisp"
        ],
        "extensions": [
          ".crp"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "crisp",
        "scopeName": "source.crisp",
        "path": "./syntaxes/crisp.tmLanguage.json"
      }
    ],
    "configuration": {
      "title": "Crisp",
      "properties": {
        "crisp.lsp.path": {
          "type": "string",
          "default": "crisp-lsp",
          "description": "Path to the crisp-lsp stdio binary (cargo install --path crates/crisp-lsp)."
        },
        "crisp.lsp.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Start crisp-lsp for .crp files when the binary is available."
        }
      }
    }
  }
}
