-- examples/net_http — std.net + HTTP via rust=true dep (§15.2 / #28 / #55)
--
-- `parse_ip` is a std.net shim (offline-friendly).
-- `ureq::get` is a thin Cargo re-export; failures become Crisp ambient errors (`?`).

use ureq { get }

pub main() = {
    log("ip={parse_ip(\"127.0.0.1\")}")
    log("bad={parse_ip(\"not-an-ip\")}")
    -- Network call (needs outbound HTTPS; CI runners usually allow it).
    body := get("https://example.com")
    print(body)
}
