-- examples/generics_implicit — free names (#75) + inferred impl args / + bounds (#77)

type Pair = {
    left: A
    right: B
}

id(x: T) = x

-- `Pair` alone is Pair with no args and will not unify with
-- `Pair { left: …, right: … }`. `<>` applies A and B; those names
-- become implicit binders on first/second. `first(p: Pair)` is rejected.
first(p: Pair<A, B>) = p.left

second(p: Pair<A, B>) = p.right

shape Boxy = {
    value: T
}

type IntBox = {
    value: int
}

type StrBox = {
    value: str
}

unwrap_int(b: Boxy<int>) = b.value

unwrap_str(b: Boxy<str>) = b.value

trait Wrapper = {
    unwrap(self) -> T
}

impl Wrapper for IntBox = {
    unwrap(self) = self.value
}

impl Wrapper for StrBox = {
    unwrap(self) = self.value
}

shape HasName = {
    name: str
}

shape HasId = {
    id: int
}

type User = {
    name: str
    id: int
}

label(u: HasName + HasId) = u.name

test "id and pair" = {
    assert_eq(id(41), 41)
    p := Pair {
        left: 1
        right: 2
    }
    assert_eq(first(p), 1)
    assert_eq(second(p), 2)
}

test "mixed pair" = {
    p := Pair {
        left: 3
        right: "hi"
    }
    assert_eq(first(p), 3)
    assert_eq(second(p), "hi")
}

test "parametric shape" = {
    b := IntBox {
        value: 7
    }
    assert_eq(unwrap_int(b), 7)
    s := StrBox {
        value: "ok"
    }
    assert_eq(unwrap_str(s), "ok")
}

test "generic trait" = {
    b := IntBox {
        value: 3
    }
    assert_eq(b.unwrap(), 3)
}

test "shape plus bound" = {
    u := User {
        name: "a"
        id: 1
    }
    assert_eq(label(u), "a")
}

test_compile_fail "str box is not Boxy<int>" = {
    s := StrBox {
        value: "no"
    }
    unwrap_int(s)
}

pub main() = {
    p := Pair {
        left: 10
        right: 20
    }
    n := first(p)
    boxed := IntBox {
        value: n
    }
    v := unwrap_int(boxed)
    w := boxed.unwrap()
    s := StrBox {
        value: "ok"
    }
    mixed := Pair {
        left: n
        right: unwrap_str(s)
    }
    u := User {
        name: "u"
        id: n
    }
    log("n={n} v={v} w={w} s={second(mixed)} mix={first(mixed)} who={label(u)}")
}
