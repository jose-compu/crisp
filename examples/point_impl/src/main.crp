-- examples/point_impl — flat inherent `impl` (spec §5.4 / #20)

type Point = {
    x: int
    y: int
}

impl Point = {
    pub new(x: int, y: int) = Point {
        x: x
        y: y
    }
    pub translate(self, dx: int, dy: int) = Point {
        x: self.x + dx
        y: self.y + dy
    }
    pub manhattan(self) = {
        ax := if self.x < 0 { 0 - self.x } else { self.x }
        ay := if self.y < 0 { 0 - self.y } else { self.y }
        ax + ay
    }
}

test "translate" = {
    p := Point.new(1, 2).translate(3, 4)
    assert_eq(p.x, 4)
    assert_eq(p.y, 6)
}

test "manhattan" = {
    assert_eq(Point.new(3, 4).manhattan(), 7)
}

pub main() = {
    p := Point.new(1, 2).translate(3, 4)
    log("x={p.x} y={p.y} d={p.manhattan()}")
}
