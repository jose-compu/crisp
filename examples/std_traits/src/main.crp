-- examples/std_traits — prelude Show / Eq / Ord shims (§15.4 / #27)
-- No local `trait Show` — uses compiler-injected prelude traits.
-- Methods: show / equal / compare (equal/compare avoid Rust PartialEq::eq / Ord::cmp clashes).
-- Emit bridges: Show→Display, Eq→PartialEq+Eq, Ord→std::cmp::Ord.

type Point = {
    x: int
    y: int
}

impl Point = {
    pub new(x: int, y: int) = Point {
        x: x
        y: y
    }
}

impl Show for Point = {
    show(self) = "({self.x},{self.y})"
}

impl Eq for Point = {
    equal(self, other: Point) = self.x == other.x && self.y == other.y
}

impl Ord for Point = {
    compare(self, other: Point) = {
        if self.x < other.x {
            0 - 1
        } else {
            if self.x > other.x {
                1
            } else {
                if self.y < other.y {
                    0 - 1
                } else {
                    if self.y > other.y {
                        1
                    } else {
                        0
                    }
                }
            }
        }
    }
}

test "show eq ord" = {
    a := Point.new(1, 2)
    b := Point.new(1, 2)
    c := Point.new(2, 0)
    assert_eq(a.show(), "(1,2)")
    assert_eq(a.equal(b), true)
    assert_eq(a.equal(c), false)
    assert_eq(a.compare(b), 0)
    assert_eq(a.compare(c), 0 - 1)
}

pub main() = {
    p := Point.new(3, 4)
    log("p={p}")
    log("show={p.show()}")
}
