// === mod arith ===
pub fn double<T: Clone + Copy + std::ops::Add<Output = T>>(n: T) -> T {
    n + n
}
pub fn sum<T: Clone + Copy + std::ops::Add<Output = T>>(a: T, b: T) -> T {
    a + b
}
pub fn product<T: Clone + Copy + std::ops::Mul<Output = T>>(a: T, b: T) -> T {
    a * b
}
