-- examples/rust_import — TypeScript-style Rust crate imports (spec §14.2 / #41)
--
-- Primary surface: bare `use <crate> { … }` when the crate is `rust = true` in crisp.toml.
-- Compat alias: `use rust.<crate> { … }` / `use rust::<crate> { … }`.
-- Calling imported Rust APIs (typeck/emit of calls) lands in a follow-up PR; this example
-- proves resolve + Cargo dep wiring end-to-end.

use serde_json { from_str, to_string }
use rust.serde_json { Value as JsonValue }

pub main() = {
    -- from_str / to_string / JsonValue are resolved into scope (see `crpc resolve`).
    print("rust-import-ok")
}
