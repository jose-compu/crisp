{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Crisp",
  "scopeName": "source.crisp",
  "patterns": [
    { "include": "#comments" },
    { "include": "#strings" },
    { "include": "#chars" },
    { "include": "#lifetimes" },
    { "include": "#numbers" },
    { "include": "#keywords" },
    { "include": "#constants" },
    { "include": "#types" },
    { "include": "#functions" },
    { "include": "#operators" }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "name": "comment.block.crisp",
          "begin": "\\{-",
          "end": "-\\}",
          "patterns": [{ "include": "#comments" }]
        },
        {
          "name": "comment.line.double-dash.crisp",
          "match": "--.*$"
        }
      ]
    },
    "strings": {
      "name": "string.quoted.double.crisp",
      "begin": "\"",
      "end": "\"",
      "patterns": [
        {
          "name": "constant.character.escape.crisp",
          "match": "\\\\."
        },
        {
          "name": "meta.interpolation.crisp",
          "begin": "\\{",
          "end": "\\}",
          "patterns": [{ "include": "$self" }]
        }
      ]
    },
    "chars": {
      "name": "string.quoted.single.crisp",
      "match": "'([^'\\\\]|\\\\.)'"
    },
    "lifetimes": {
      "name": "storage.modifier.lifetime.crisp",
      "match": "'[A-Za-z_][A-Za-z0-9_]*"
    },
    "numbers": {
      "patterns": [
        {
          "name": "constant.numeric.float.crisp",
          "match": "\\b\\d+\\.\\d+([eE][+-]?\\d+)?\\b"
        },
        {
          "name": "constant.numeric.integer.crisp",
          "match": "\\b\\d+\\b"
        }
      ]
    },
    "keywords": {
      "patterns": [
        {
          "name": "keyword.control.crisp",
          "match": "\\b(if|then|else|match|with|for|in|while|do|loop|return|break|continue|catch|throw|panic)\\b"
        },
        {
          "name": "keyword.declaration.crisp",
          "match": "\\b(type|trait|shape|impl|use|as|mod|pub|extern|test|test_compile_fail)\\b"
        },
        {
          "name": "keyword.other.crisp",
          "match": "\\b(own|mut|ref|shared|rc|arc|async|await|spawn|unsafe)\\b"
        },
        {
          "name": "storage.type.function.crisp",
          "match": "\\b(fn)\\b"
        }
      ]
    },
    "constants": {
      "patterns": [
        {
          "name": "constant.language.boolean.crisp",
          "match": "\\b(true|false)\\b"
        },
        {
          "name": "constant.language.option.crisp",
          "match": "\\b(none|some|None|Some)\\b"
        }
      ]
    },
    "types": {
      "patterns": [
        {
          "name": "entity.name.type.crisp",
          "match": "\\b[A-Z][A-Za-z0-9_]*\\b"
        },
        {
          "name": "support.type.primitive.crisp",
          "match": "\\b(int|uint|float|bool|char|str|Never|vec|map|set)\\b"
        }
      ]
    },
    "functions": {
      "patterns": [
        {
          "name": "entity.name.function.crisp",
          "match": "\\b([a-z_][A-Za-z0-9_]*)\\s*(?=\\()"
        }
      ]
    },
    "operators": {
      "patterns": [
        {
          "name": "keyword.operator.assignment.crisp",
          "match": "(:=|mut:=|\\+=|-=|\\*=|/=|%=|=)"
        },
        {
          "name": "keyword.operator.comparison.crisp",
          "match": "(==|!=|<=|>=|<|>)"
        },
        {
          "name": "keyword.operator.logical.crisp",
          "match": "(&&|\\|\\||&&&|\\|\\|\\||\\^\\^\\^)"
        },
        {
          "name": "keyword.operator.arrow.crisp",
          "match": "(->|\\|>)"
        },
        {
          "name": "keyword.operator.range.crisp",
          "match": "(\\.\\.=|\\.\\.)"
        },
        {
          "name": "keyword.operator.arithmetic.crisp",
          "match": "(\\+\\+|\\*\\*|<<|>>|[+\\-*/%])"
        },
        {
          "name": "keyword.operator.borrow.crisp",
          "match": "(&mut|&)"
        },
        {
          "name": "keyword.operator.other.crisp",
          "match": "[!?|\\^~]"
        }
      ]
    }
  }
}
