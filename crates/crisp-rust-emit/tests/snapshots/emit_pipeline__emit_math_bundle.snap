// === mod arith ===
pub fn double<T: Clone + Copy + std::ops::Add<Output = T>>(n: T) -> T {
    n + n
}
pub fn sum<T: Clone + Copy + std::ops::Add<Output = T>>(a: T, b: T) -> T {
    a + b
}
pub fn product<T: Clone + Copy + std::ops::Mul<Output = T>>(a: T, b: T) -> T {
    a * b
}
// === mod floats ===
pub fn add(a: f64, b: f64) -> f64 {
    a + b
}
pub fn mul(a: f64, b: f64) -> f64 {
    a * b
}
pub fn div(a: f64, b: f64) -> f64 {
    a / b
}
pub fn square(x: f64) -> f64 {
    (x).powf(2.0)
}
pub fn avg2(a: f64, b: f64) -> f64 {
    let s = a + b;
    s / 2.0
}
