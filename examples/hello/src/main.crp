-- examples/hello — shapes, implicit generics, defaults, interpolation

shape Named = {
    name: str
}

type Guest = {
    name: str = "world"
}

id(x: T) = x

greet(who: Named) = "hello {who.name}"

test "greet guest" = {
    g := Guest { name: "world" }
    assert_eq(id(greet(g)), "hello world")
}

pub main() = {
    world := Guest {}
    print(id(greet(world)))
}
