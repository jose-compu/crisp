-- examples/rust_import — call APIs from a Rust crate (spec §14.2 / #41 / #55)
--
-- Primary surface: bare `use <crate> { … }` when the crate is `rust = true` in crisp.toml.
-- Compat alias: `use rust.<crate> { … }` / `use rust::<crate> { … }`.
--
-- Note: Crisp string `{name}` is interpolation, so JSON objects with `{…}` need concatenation
-- or a non-object payload. This demo uses a JSON array.
--
-- Known Result-returning Rust APIs lower to Crisp ambient errors (`CrispError::Thrown` + `?`).

use serde_json { from_str, to_string }

pub main() = {
    v := from_str("[1, true, \"crisp\"]")
    s := to_string(v)
    print(s)
}
