-- math floats module — f64 arithmetic (spec §3)

pub add(a: float, b: float) = a + b

pub mul(a: float, b: float) = a * b

pub div(a: float, b: float) = a / b

pub square(x: float) = x ** 2.0

pub avg2(a: float, b: float) = {
    s := a + b
    s / 2.0
}

-- Discrete Laplacian (#113): unary minus on a float stays float.
pub lap3(um: float, uc: float, up: float, dx: float) = (um + up - 2.0 * uc) / (dx * dx)

-- Checking-position int → float (#112).
pub add_mix(a: float, n: int) = a + n

test "float add" = {
    assert_eq(add(1.5, 2.5), 4.0)
}

test "float mul" = {
    assert_eq(mul(2.0, 3.5), 7.0)
}

test "float square" = {
    assert_eq(square(3.0), 9.0)
}

test "lap3 spike unary minus" = {
    a := lap3(0.0, 1.0, 0.0, 1.0)
    assert_eq(a, -2.0)
}

test "lap3 spike binop rhs" = {
    a := lap3(0.0, 1.0, 0.0, 1.0)
    assert_eq(a, 0.0 - 2.0)
}

test "int widens to float" = {
    assert_eq(add_mix(1.0, 1), 2.0)
}

test_compile_fail "float bool mix" = {
    add(1.0, true)
}
